{
  "name": "split-duo-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "gen:api": "openapi-typescript ../docs/api/splitduoapi-v1.yaml --output app/types/api.d.ts",
    "check:locales": "node -e \"import('./scripts/check-locale-parity.mjs').then(m => { const r = m.checkLocaleParity(); if (r.ok) { console.log('Locale key parity: OK'); process.exit(0); } else { for (const e of r.errors) { console.error('\\n' + e.file + ':'); if (e.missing.length) console.error('  Missing keys: ' + e.missing.join(', ')); if (e.extra.length) console.error('  Extra keys:   ' + e.extra.join(', ')); if (e.error) console.error('  Error: ' + e.error); } process.exit(1); } })\""
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@iconify-json/simple-icons": "^1.2.90",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/core": "^14.4.0",
    "apexcharts": "^5.16.0",
    "nuxt": "^4.4.8",
    "uqr": "^0.1.3",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^26.1.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^10.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
